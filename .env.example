# Supabase (pre-populated by Bolt)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the browser. Used by Edge Functions / route handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry (optional)
# Client DSN is safe to expose; it only sends events to your project.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only — used by `sentry-cli` / `@sentry/next` for source maps. Never prefix with NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
